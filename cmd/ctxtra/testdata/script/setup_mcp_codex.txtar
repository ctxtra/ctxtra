# With MCP servers in the config, setup adds the ctxtra MCP
# proxy to Codex's config.toml between markers, with env_vars and
# startup_timeout_sec, keeps the rest byte for byte, and --remove restores
# the file. A user key in ctxtra's table stays.

mkdir .config/ctxtra
cp config.yaml .config/ctxtra/config.yaml
mkdir .codex
cp original.toml .codex/config.toml

exec ctxtra setup --dry-run --agent codex
cmp .codex/config.toml original.toml

exec ctxtra setup --agent codex
stdout '~/.codex/config.toml'
grep '^# >>> ctxtra MCP proxy: written by ctxtra setup; keys you add are kept$' .codex/config.toml
grep '^\[mcp_servers.ctxtra-proxy\]$' .codex/config.toml
grep '^args = \["mcp", "proxy", "codex", "--setup-version=1"\]$' .codex/config.toml
grep '^env_vars = \["XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME", "CTXTRA_LOG", .*"HTTPS_PROXY", "https_proxy", .*"SSL_CERT_FILE", "SSL_CERT_DIR", "PGHOST"\]$' .codex/config.toml
grep '^startup_timeout_sec = 30$' .codex/config.toml
grep '^required = true$' .codex/config.toml
grep '^# <<< ctxtra MCP proxy$' .codex/config.toml
exists .local/state/ctxtra/backups
exec ctxtra setup --agent codex
stdout 'is already set up for'

! exec ctxtra doctor
stdout '    MCP: MCP entry runs .*/ctxtra \(ok\) \(~/.codex/config.toml\)'

# A server with a new pass-env name: Codex must pass it too.
exec ctxtra mcp add db --pass-env DBHOST -- mcptest
stdout 'run ctxtra setup: ctxtra''s MCP proxy in codex needs it'
! exec ctxtra doctor
stdout 'the ctxtra MCP entry doesn''t pass DBHOST to the proxy; run ctxtra setup --agent codex'
exec ctxtra binding add db --mcp-server db
runhook codex SessionStart .
stdout '\\nℹ the ctxtra MCP entry doesn''t pass DBHOST to the proxy; run ctxtra setup --agent codex'
exec ctxtra setup --agent codex
grep '"DBHOST", "PGHOST"\]$' .codex/config.toml
runhook codex SessionStart .
stdout 'MCP server'
! stdout 'doesn''t pass'

# A key the user adds in ctxtra's table stays.
exec sed -i.bak 's/^startup_timeout_sec = 30$/startup_timeout_sec = 30\ndefault_tools_approval_mode = "approve"/' .codex/config.toml
exec ctxtra setup --agent codex
grep '^default_tools_approval_mode = "approve"$' .codex/config.toml

# Another entry named ctxtra-proxy: left alone.
cp other.toml .codex/config.toml
! exec ctxtra setup --agent codex
stderr 'the ctxtra MCP proxy isn''t the one ctxtra setup wrote; left alone'
cmp .codex/config.toml other.toml

# The block under its old name, ctxtra: setup renames it, with the user's
# keys and tables; --remove then restores the file.
cp legacy.toml .codex/config.toml
exec ctxtra binding list
stderr '^codex: the ctxtra MCP proxy has its old name ctxtra; run ctxtra setup --agent codex$'
exec ctxtra setup --agent codex
! grep 'ctxtra MCP server' .codex/config.toml
! grep 'mcp_servers.ctxtra[].]' .codex/config.toml
grep '^\[mcp_servers.ctxtra-proxy\]$' .codex/config.toml
grep '^default_tools_approval_mode = "approve"$' .codex/config.toml
grep '^\[mcp_servers.ctxtra-proxy.tools.pg__query\]$' .codex/config.toml
exec ctxtra binding list
! stderr .
exec ctxtra setup --remove --agent codex
! grep 'ctxtra' .codex/config.toml

cp original.toml .codex/config.toml
exec ctxtra setup --agent codex
exec ctxtra setup --remove --agent codex
cmp .codex/config.toml original.toml

-- config.yaml --
schema: ctxtra/config/v1
mcp-servers:
  pg: {command: [pg-mcp], pass-env: [PGHOST]}
-- original.toml --
model = "gpt-6.1-sol"

[mcp_servers.linear]
url = "https://mcp.linear.app/mcp"

[projects."/home/me/api"]
trust_level = "trusted"
-- other.toml --
[mcp_servers.ctxtra-proxy]
command = "npx"
-- legacy.toml --
model = "gpt-6.1-sol"

[mcp_servers.linear]
url = "https://mcp.linear.app/mcp"

[projects."/home/me/api"]
trust_level = "trusted"

# >>> ctxtra MCP server: written by ctxtra setup; keys you add are kept
[mcp_servers.ctxtra]
command = "/old/ctxtra"
args = ["mcp", "proxy", "codex", "--setup-version=1"]
env_vars = ["XDG_CONFIG_HOME"]
startup_timeout_sec = 30
default_tools_approval_mode = "approve"
required = true
# <<< ctxtra MCP server

[mcp_servers.ctxtra.tools.pg__query]
approval_mode = "approve"
