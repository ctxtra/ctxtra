# Validate only the top-level source manifest, without config, trust or network.
gitrepo team-ctx/nested
gitrepo team-ctx git@github.com:acme/team-ctx.git
mkdir .config/ctxtra
cp broken.yaml .config/ctxtra/config.yaml
cp team-ctx/ctxtra-source.yaml valid.yaml

exec ctxtra source validate team-ctx
stdout '^validated ~/team-ctx/ctxtra-source.yaml: 2 collections, 0 MCP servers, 0 repo sets$'
stdout '^0 errors, 0 warnings$'
! stdout 'example.yaml'
cd team-ctx
exec ctxtra source validate .
stdout '^validated ~/team-ctx/ctxtra-source.yaml: 2 collections, 0 MCP servers, 0 repo sets$'
cd $HOME

# Shape and entry errors name the manifest line.
cp broken-manifest.yaml team-ctx/ctxtra-source.yaml
! exec ctxtra source validate team-ctx
stdout '^error: line 4: collection typo: unknown key "instrutions"'
stdout '^error: line 6: collection other-source: .*a manifest references only files in its own source'
stdout '^error: line 8: collection home: .*relative'
stdout '^error: line 10: collection outside: .*leaves its source'
stdout '^4 errors, 0 warnings$'
cp sets.yaml team-ctx/ctxtra-source.yaml
! exec ctxtra source validate team-ctx
stdout '^validated ~/team-ctx/ctxtra-source.yaml: 0 collections, 0 MCP servers, 2 repo sets$'
stdout '^error: line 4: repo set services: ~/work/\*\* is a folder; a set lists repositories only; the entry is left out$'
stdout '^error: line 5: repo set services: iam-team:web is not a repository: a set lists repositories, such as github.com/acme/api, not other sets; the entry is left out$'
stdout '^error: line 7: repo set web: unknown key "subdir"'
stdout '^3 errors, 0 warnings$'
cp config-only.yaml team-ctx/ctxtra-source.yaml
! exec ctxtra source validate team-ctx
stdout 'a source provides content, and the user'
stdout '^1 error, 0 warnings$'
cp bindings.yaml team-ctx/ctxtra-source.yaml
! exec ctxtra source validate team-ctx
stdout 'a source provides content, and the user'
cp bad-yaml.yaml team-ctx/ctxtra-source.yaml
! exec ctxtra source validate team-ctx
stdout '^error: .*YAML'
cp foreign.yaml team-ctx/ctxtra-source.yaml
! exec ctxtra source validate team-ctx
stdout 'a manifest references only files in its own source'
cp valid.yaml team-ctx/ctxtra-source.yaml

# Validation reads no setup state and writes nothing.
mkdir .cursor .local/state/ctxtra
cp setup.json .local/state/ctxtra/setup.json
exec ctxtra source validate team-ctx
! stderr .
cmp .local/state/ctxtra/setup.json setup.json
! exists .local/state/ctxtra/setup.lock
exec ctxtra source validate team-ctx --json
stdout '"collections": 2'
stdout '"mcp_servers": 0'
stdout '"repo_sets": 0'
stdout '"errors": 0'
! stdout 'not checked'

# A manifest over the sessions' limit is an error, as sessions read it.
mkdir big
cp big-head.yaml big/ctxtra-source.yaml
exec sh -c 'i=0; while [ $i -lt 1200 ]; do printf "#%01023d\n" 0; i=$((i+1)); done >> big/ctxtra-source.yaml'
! exec ctxtra source validate big
stdout '^error: .*ctxtra-source.yaml is larger than 1048576 bytes'
stdout '^1 error, 0 warnings$'

# A skill larger than a manifest may be, but within the limit for one file.
mkdir large/skills/large
cp large.yaml large/ctxtra-source.yaml
cp skill.md large/skills/large/SKILL.md
exec sh -c 'i=0; while [ $i -lt 1100 ]; do printf "%01023d\n" 0; i=$((i+1)); done >> large/skills/large/SKILL.md'
exec ctxtra source validate large
stdout '^0 errors, 0 warnings$'

mkdir empty
! exec ctxtra source validate empty
stderr '^ctxtra source validate: ~/empty has no ctxtra-source.yaml$'
! exec ctxtra source validate skill.md
stderr 'is not a folder'
! exec ctxtra source validate nope
stderr '^ctxtra source validate: ~/nope does not exist$'
! exec ctxtra source validate
stderr 'expected DIR'
! exec ctxtra source validate team-ctx ../x.yaml
stderr 'Usage: ctxtra source validate DIR'

# Collections are read as sessions read them from an accepted commit.
mv team-ctx/instructions/security.md team-ctx/instructions/secure.md
! exec ctxtra source validate team-ctx
stdout '^error: .*work.*instructions/security.md.*not a file'
stdout '^1 error, 0 warnings$'
mv team-ctx/instructions/secure.md team-ctx/instructions/security.md
cp skill-nodesc.md team-ctx/skills/deploy/SKILL.md
! exec ctxtra source validate team-ctx
stdout '^error: .*tools.*skills/deploy/SKILL.md.*frontmatter has no description'
rm team-ctx/skills/deploy/SKILL.md
! exec ctxtra source validate team-ctx
stdout '^error: .*tools.*skills/deploy is not a skill folder with a SKILL.md'
cp skill.md team-ctx/skills/deploy/SKILL.md
cp globs.yaml team-ctx/ctxtra-source.yaml
! exec ctxtra source validate team-ctx
stdout '^error: .*drafts/\*.md.*matches no file'
stdout '^error: .*instructions/nope.md.*excludes nothing'
stdout '^2 errors, 0 warnings$'
cp left-out.yaml team-ctx/ctxtra-source.yaml
symlink team-ctx/instructions/link.md -> security.md
cp nested.md team-ctx/nested/a.md
! exec ctxtra source validate team-ctx
stdout '^error: .*instructions/link.md.*symlink'
stdout '^error: .*nested/a.md.*nested repository or submodule'
stdout '^2 errors, 0 warnings$'
cp all.yaml team-ctx/ctxtra-source.yaml
! exec ctxtra source validate team-ctx
stdout '^error: .*\.git\*/\*\*.*matches no file'
stdout '^error: .*all: .*nested/a.md.*nested repository or submodule'
stdout '^2 errors, 0 warnings$'
cp cycle.yaml team-ctx/ctxtra-source.yaml
! exec ctxtra source validate team-ctx
stdout '^error: line 3: collections a and b nest each other, so they add nothing'
stdout '^error: .*collection c: source team-ctx has no collection gone'
stdout '^2 errors, 0 warnings$'
cp unquoted.yaml team-ctx/ctxtra-source.yaml
! exec ctxtra source validate team-ctx
stdout 'quote'
cp git-path.yaml team-ctx/ctxtra-source.yaml
mkdir outside
cp nested.md outside/x.md
symlink team-ctx/linked -> ../outside
! exec ctxtra source validate team-ctx
stdout '^error: .*\.git/config.*not a path'
stdout '^error: .*linked/\*.md.*symlink'
rm outside/x.md
! exec ctxtra source validate team-ctx
stdout 'symlink'

-- large.yaml --
schema: ctxtra/source/v1
collections:
  kit: {skills: [skills/large]}
-- big-head.yaml --
schema: ctxtra/source/v1
collections:
  kit: {instructions: [missing.md]}
-- broken.yaml --
schema: ctxtra/config/v1
bindings: [
-- team-ctx/README.md --
Agent context for acme.
-- team-ctx/examples/example.yaml --
# Not a binding file: no ctxtra schema.
key: value
-- team-ctx/instructions/security.md --
Never log tokens.
-- team-ctx/instructions/style.md --
Short functions.
-- team-ctx/skills/deploy/SKILL.md --
---
name: deploy
description: Deploys a service.
---
Run the pipeline.
-- skill.md --
---
name: deploy
description: Deploys a service.
---
Run the pipeline.
-- skill-nodesc.md --
---
name: deploy
---
Run the pipeline.
-- broken-manifest.yaml --
schema: ctxtra/source/v1
collections:
  typo:
    instrutions: [instructions/style.md]
  other-source:
    instructions: [other:a.md]
  home:
    instructions: [~/me.md]
  outside:
    instructions: [../outside.md]
-- config-only.yaml --
schema: ctxtra/source/v1
sources:
  x: {dir: ~/x}
-- bindings.yaml --
schema: ctxtra/source/v1
bindings: []
-- bad-yaml.yaml --
schema: ctxtra/source/v1
collections: [
-- globs.yaml --
schema: ctxtra/source/v1
collections:
  globs:
    instructions: ['drafts/*.md', instructions/security.md, '!instructions/nope.md']
-- foreign.yaml --
schema: ctxtra/source/v1
collections:
  foreign:
    instructions: [team-ctx:instructions/style.md]
-- left-out.yaml --
schema: ctxtra/source/v1
collections:
  left-out:
    instructions: [instructions/link.md, nested/a.md, instructions/style.md]
-- nested.md --
In a submodule.
-- git-path.yaml --
schema: ctxtra/source/v1
collections:
  git-path:
    instructions: [.git/config]
  linked:
    instructions: [linked/*.md]
-- cycle.yaml --
schema: ctxtra/source/v1
collections:
  a: {collections: [b], instructions: [instructions/style.md]}
  b: {collections: [a]}
  c: {collections: [a, gone], instructions: [instructions/style.md]}
-- unquoted.yaml --
schema: ctxtra/source/v1
collections:
  work:
    instructions: [instructions/*.md, !instructions/style.md]
-- all.yaml --
schema: ctxtra/source/v1
collections:
  all:
    instructions: ['**/*.md', '.git*/**', '{nested/a.md,missing.md}']
-- setup.json --
{"installed": {}, "detected": []}
-- team-ctx/ctxtra-source.yaml --
schema: ctxtra/source/v1
collections:
  work:
    instructions: [instructions/security.md, instructions/style.md]
  tools:
    skills: [skills/deploy]
-- sets.yaml --
schema: ctxtra/source/v1
repo-sets:
  services:
    - ~/work/**
    - iam-team:web
    - github.com/acme/iam-*
  web: [{repo: github.com/acme/mono, subdir: web}]
