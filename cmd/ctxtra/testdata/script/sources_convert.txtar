# Reviewed commits and an explicitly trusted live folder are independent.
gitrepo srv/dotfiles
gitrepo srv/team-ctx
gitrepo srv/other
exec git clone -q $GITSRV/dotfiles dev/dotfiles
exec git clone -q $GITSRV/team-ctx dev/team-ctx

exec ctxtra source add --repo $HOME/dev/dotfiles
stdout 'added source dotfiles'
! exec ctxtra source trust dotfiles --dry-run
stderr 'is a repo source'
grep 'repo: ~/dev/dotfiles' .config/ctxtra/config.yaml
exec ctxtra source add --dir dev/dotfiles --name dotfiles-live
exec ctxtra source trust dotfiles-live --dry-run
stdout '^would trust dotfiles-live with the remotes '
! exists .local/state/ctxtra/trusted-dirs.json
exec ctxtra source trust dotfiles-live
stdout '^trusted dotfiles-live: ~/dev/dotfiles is read live while its repository has the remotes '
grep '^    dir: ~/dev/dotfiles$' .config/ctxtra/config.yaml
grep '^    repo: ~/dev/dotfiles$' .config/ctxtra/config.yaml
exec ctxtra binding add work --instruction dotfiles-live:work.md
cp live.md dev/dotfiles/work.md
exec ctxtra context files notes
stdout '^.*/dev/dotfiles/work.md$'
exec ctxtra context show notes
stdout 'LIVE-EDIT'

exec ctxtra source add --repo $HOME/dev/team-ctx
exec ctxtra binding add pinned --instruction team-ctx:services-overview.md
cp live.md dev/team-ctx/services-overview.md
exec ctxtra source add --dir dev/team-ctx --name team-ctx-live
stdout '^added source team-ctx-live: dir ~/dev/team-ctx, read live; changes apply to new sessions right away$'
exec ctxtra source trust team-ctx-live
grep 'repo: ~/dev/team-ctx' .config/ctxtra/config.yaml
exec ctxtra binding add own --instruction dev/team-ctx/jira-ticket.md
exec ctxtra context show notes
stdout 'Contents of .*/.local/share/ctxtra/store/.*/services-overview.md'
stdout 'Contents of .*/dev/team-ctx/jira-ticket.md'

exec ctxtra source add --repo $GITSRV/other
! exec ctxtra source trust other
stderr 'is a repo source'

-- notes/.keep --
-- live.md --
LIVE-EDIT
-- srv/dotfiles/work.md --
work
-- srv/team-ctx/jira-ticket.md --
jira
-- srv/team-ctx/services-overview.md --
overview
-- srv/other/a.md --
other
