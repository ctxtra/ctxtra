# Each file's header says which sessions get it. Only a binding without
# conditions is for every session; profiles and agents are named.
mkdir dev/app
gitrepo dev/svc git@github.com:acme/svc.git

exec ctxtra context show dev/app --agent codex --profile iam
stdout '^Contents of .*/ctx/me.md \(instructions added by ctxtra for every session; binding: me\):$'
stdout '^Contents of .*/ctx/iam.md \(instructions added by ctxtra for sessions with the profile iam; binding: iam\):$'
stdout '^Contents of .*/ctx/codex.md \(instructions added by ctxtra for codex sessions; binding: codex\):$'
stdout '^Contents of .*/ctx/calm.md \(instructions added by ctxtra for sessions without the profile oncall; binding: calm\):$'
stdout '^Contents of .*/ctx/dev.md \(instructions added by ctxtra for codex sessions in ~/dev/app with the profile iam; binding: dev\):$'
! stdout 'svc.md'

exec ctxtra context show dev/svc --agent codex --profile iam
stdout '^Contents of .*/ctx/svc.md \(instructions added by ctxtra for this repository, ~/dev/svc, and all its worktrees; binding: svc\):$'
stdout '^Contents of .*/ctx/svc-codex.md \(instructions added by ctxtra for codex sessions in this repository, ~/dev/svc, and all its worktrees; binding: svc-codex\):$'

-- .config/ctxtra/config.yaml --
schema: ctxtra/config/v1
bindings:
  - name: me
    instructions: [~/ctx/me.md]
  - name: iam
    profiles: [iam, ops]
    instructions: [~/ctx/iam.md]
  - name: codex
    agents: [codex]
    instructions: [~/ctx/codex.md]
  - name: calm
    profiles: ['!oncall']
    instructions: [~/ctx/calm.md]
  - name: dev
    location:
      dirs: ['~/dev/**']
    agents: ['!cursor']
    profiles: [iam]
    instructions: [~/ctx/dev.md]
  - name: svc
    location:
      repos: [github.com/acme/svc]
    instructions: [~/ctx/svc.md]
  - name: svc-codex
    location:
      repos: [github.com/acme/svc]
    agents: [codex]
    instructions: [~/ctx/svc-codex.md]
-- ctx/me.md --
ME
-- ctx/iam.md --
IAM
-- ctx/codex.md --
CODEX
-- ctx/calm.md --
CALM
-- ctx/dev.md --
DEV
-- ctx/svc.md --
SVC
-- ctx/svc-codex.md --
SVC-CODEX
