# State removed: with the state folder deleted, no stored profile is active,
# servers from sources aren't started, and the session message says to
# approve them and sign in again. Files of accepted commits stay in the data
# folder.
env BROWSER=fakebrowser
fakeauth
mkdir dev/app
expand manifest.yaml srv/iam-team/ctxtra-source.yaml
gitrepo srv/iam-team
exec ctxtra source add --repo $GITSRV/iam-team
exec sh -c 'cat bindings.yaml >> .config/ctxtra/config.yaml'
exec ctxtra setup --agent claude-code
exec ctxtra profile set iam
stdin yes.txt
exec ctxtra-tty mcp approve iam-team:deploy
stdin yes.txt
exec ctxtra-tty mcp login iam-team:jira
stdout '^signed in to iam-team:jira'
mcp dev/app
stdout '^tool deploy__echo'
stdout '^tool jira__list_issues'
runhook claude-code SessionStart dev/app
stdout 'IAM_NOTES'
stdout 'PROFILE_NOTES'
stdout 'Profiles: iam \(from stored selection\)'

rm .local/state/ctxtra
runhook claude-code SessionStart dev/app
stdout 'IAM_NOTES'
! stdout 'PROFILE_NOTES'
! stdout 'Profiles:'
stdout 'iam-team:deploy needs approval: run ctxtra mcp approve iam-team:deploy\\n'
stdout 'iam-team:jira needs approval and may need sign-in: run ctxtra mcp approve iam-team:jira, then ctxtra mcp login iam-team:jira'
mcp dev/app
! stdout 'deploy__'
! stdout 'jira__'

-- yes.txt --
y
-- bindings.yaml --
bindings:
  - name: iam
    collections: ['iam-team:essentials']
  - name: profile
    profiles: [iam]
    instructions: ['iam-team:profile.md']
-- manifest.yaml --
schema: ctxtra/source/v1
collections:
  essentials:
    instructions: [docs/*.md]
    mcp-servers: [deploy, jira]
mcp-servers:
  deploy:
    command: [mcptest]
  jira:
    url: $FAKE_MCP
-- srv/iam-team/docs/a.md --
IAM_NOTES
-- srv/iam-team/profile.md --
PROFILE_NOTES
