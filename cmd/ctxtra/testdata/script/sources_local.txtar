# Sources are explicit repositories or live folders. Only bindings choose
# which sessions use their content.
gitrepo dev/dotfiles git@github.com:me/dotfiles.git
gitrepo srv/team

exec ctxtra source add --dir dev/dotfiles --dry-run
stdout '^would add source dotfiles: dir ~/dev/dotfiles, read live$'
stdout '^nothing changed \(--dry-run\)$'
! exists .config/ctxtra/config.yaml
exec ctxtra source add --dir dev/dotfiles
stdout '^created ~/.config/ctxtra/config.yaml$'
stdout '^added source dotfiles: dir ~/dev/dotfiles, read live; changes apply to new sessions right away$'
stdout 'to read it live, run ctxtra source trust dotfiles'
exec ctxtra source trust dotfiles
exec ctxtra binding add work --repo 'github.com/acme/**' --instruction dotfiles:work.md
stdout '^added binding work'
stdout '^      - dotfiles:work.md$'
stdout '^  file +dotfiles:work.md$'
exec ctxtra context files notes
! stdout work.md

# A folder without remotes is live without separate trust.
exec ctxtra source add --dir notes --name my-notes
stdout '^added source my-notes: dir ~/notes, read live; changes apply to new sessions right away$'
stdout '^it has no ctxtra-source.yaml; its files:$'
stdout '^  me.md$'
cp .config/ctxtra/config.yaml before.yaml
exec ctxtra source add --dir notes
stdout 'is the source my-notes already'
cmp .config/ctxtra/config.yaml before.yaml
! exec ctxtra source add --dir notes/me.md
stderr 'is not a folder'
! exec ctxtra binding add outside --instruction dotfiles:../notes/me.md --dry-run
stderr 'leaves its source'

exec ctxtra-tty source update
stdout '^no repo sources$'
! exec ctxtra-tty source update dotfiles
stderr 'is a dir source'

# A repo written by hand is inactive until the first accepted lock entry.
expand handwritten.yaml .config/ctxtra/config.yaml
! exec ctxtra context files notes
stderr 'source team: ctxtra.lock has no accepted commit of it; run `ctxtra source update team`'
exec ctxtra source update --dry-run
stdout '^team: no accepted commit for it yet; main is at [0-9a-f]{7}'
stdout '^\+team$'
stdout '^team: not accepted \(--dry-run\)'
! exec ctxtra source download team
stderr 'ctxtra.lock has no accepted commit of it'
stdin no.txt
exec ctxtra-tty source update
stdout '^not accepted; team has no accepted commit yet$'
! exec ctxtra context files notes
stdin yes.txt
exec ctxtra-tty source update
stdout '^accepted team [0-9a-f]{7} \(ctxtra.lock updated\)$'
exec ctxtra context files notes
stdout '/.local/share/ctxtra/store/.*/a.md'

# Bad inputs never become guessed network addresses.
! exec ctxtra source add --repo file:///tmp/x
stderr 'not a git URL'
! exec ctxtra source add --repo team/missing
stderr 'is not in a git clone with a working tree'
! exec ctxtra source add --repo ./missing
stderr 'is not in a git clone with a working tree'
cp .config/ctxtra/config.yaml before.yaml
exec ctxtra source add --repo $GITSRV/team
stdout 'is the source team already'
cmp .config/ctxtra/config.yaml before.yaml
! exec ctxtra source add --repo $GITSRV/team/ --branch other --name dotfiles
stderr 'the name dotfiles is taken by the source for dir ~/dev/dotfiles; choose another name with --name'

-- no.txt --
n
-- yes.txt --
y
-- handwritten.yaml --
schema: ctxtra/config/v1
sources:
  dotfiles:
    dir: ~/dev/dotfiles
  team:
    repo: $GITSRV/team
    branch: main
bindings:
  - name: me
    instructions: [~/notes/me.md]
  - name: team
    instructions: [team:a.md]
-- notes/me.md --
mine
-- dev/dotfiles/work.md --
work
-- srv/team/a.md --
team
