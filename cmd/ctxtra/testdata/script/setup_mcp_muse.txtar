# Muse records the folders used by setup in hook and proxy entries.
env XDG_CONFIG_HOME=$HOME/ctx
exec ctxtra setup --dry-run --agent muse
! exists ctx/muse/settings.json
exec ctxtra setup --agent muse
grep '"mode": "optional"' ctx/muse/settings.json
grep '"env":' ctx/muse/settings.json
grep 'XDG_CONFIG_HOME' ctx/muse/settings.json
! grep '"configs":' .local/state/ctxtra/setup.json
exec ctxtra setup --agent muse
stdout 'is already set up for'
runhook muse SessionStart .
stdout 'CUSTOM_CONFIG_MARKER'
exec ctxtra setup --remove --agent muse
! grep '"ctxtra-proxy":' ctx/muse/settings.json

-- ctx/ctxtra/config.yaml --
schema: ctxtra/v1
check-updates: false
mcp-servers:
  pg: {command: [pg-mcp]}
bindings:
  - name: custom
    match: {global: true}
    instructions: [custom.md]
-- ctx/ctxtra/custom.md --
CUSTOM_CONFIG_MARKER
