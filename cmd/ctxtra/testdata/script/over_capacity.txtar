# Over capacity is an error: a glob adds a large folder over max-ctx-chars.
# The session starts with what fits, and its message, the log, context
# explain, doctor (exit 1) and mcp status say max-ctx-chars is exceeded and
# by which bindings.
mkdir dev/app
exec ctxtra setup --agent claude-code
mkdir .config/ctxtra
cp config.yaml .config/ctxtra/config.yaml

runhook claude-code SessionStart dev/app
stdout 'CTXMARK-me'
! stdout 'CTXMARK-big'
stdout '1 error, dropped a.md, b.md, c.md of binding big \(over max-ctx-chars\) \(run ctxtra doctor\)'
grep '"error\w*":.*the text is over max-ctx-chars; 3 files of bindings big are left out' .local/state/ctxtra/log.jsonl

! exec ctxtra context explain dev/app
stdout 'the text is over max-ctx-chars; 3 files of bindings big are left out'
! exec ctxtra context explain --json dev/app
stdout '"severity": "error",\s+"message": "dropped \(over max-ctx-chars\): [^"]*/big/a.md"'

! exec ctxtra doctor dev/app
stdout 'ERROR: the text is over max-ctx-chars; 3 files of bindings big are left out \(claude-code\)'

! exec ctxtra mcp status dev/app --agent claude-code
stdout '^error: the text is over max-ctx-chars; 3 files of bindings big are left out; see ctxtra doctor$'
stdout 'linear'

# With no server bound, mcp status still reports it, and exits 1.
cp no-servers.yaml .config/ctxtra/config.yaml
! exec ctxtra mcp status dev/app --agent claude-code
stdout '^error: the text is over max-ctx-chars; 3 files of bindings big are left out; see ctxtra doctor$'
stdout '^no MCP servers are bound to ~/dev/app$'

-- me.md --
CTXMARK-me
-- big/a.md --
CTXMARK-big aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
-- big/b.md --
CTXMARK-big bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
-- big/c.md --
CTXMARK-big cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
-- config.yaml --
schema: ctxtra/config/v1
mcp-servers:
  linear: {url: https://mcp.linear.app/mcp}
bindings:
  - name: me
    instructions: [~/me.md]
    mcp-servers: [linear]
  - name: big
    instructions: ['~/big/*.md']
max-ctx-chars: 200
-- no-servers.yaml --
schema: ctxtra/config/v1
bindings:
  - name: me
    instructions: [~/me.md]
  - name: big
    instructions: ['~/big/*.md']
max-ctx-chars: 200
