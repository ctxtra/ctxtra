# With MCP servers in the config, setup adds one MCP server
# named ctxtra-proxy to ~/.claude.json, keeps the rest of the file, is
# idempotent, backs up what it changes, and --remove restores the file.

mkdir .config/ctxtra
cp config.yaml .config/ctxtra/config.yaml

# Setup previews and installs the entry without an opt-in variable.
exec ctxtra setup --dry-run --agent claude-code
stdout '\.claude\.json'
cmp .claude.json original.json

exec ctxtra setup --agent claude-code
stdout '~/.claude.json'
cmpenv .claude.json want.json
exists .local/state/ctxtra/backups

exec ctxtra setup --agent claude-code
stdout 'is already set up for'

exec ctxtra doctor
stdout '    MCP: MCP entry runs .*/ctxtra \(ok\) \(~/.claude.json\)'
! stderr .

exec ctxtra setup --remove --agent claude-code
cmp .claude.json original.json
exec ctxtra setup --remove --agent claude-code
stdout 'isn''t set up for'

# Servers added after setup need no new entry. A removed entry is reported.
cp empty.yaml .config/ctxtra/config.yaml
exec ctxtra setup --agent claude-code
cmpenv .claude.json want.json
cp config.yaml .config/ctxtra/config.yaml
exec ctxtra binding list
! stderr .
exec ctxtra setup --agent claude-code
exec ctxtra binding list
! stderr .
cp original.json .claude.json
exec ctxtra binding list
stderr '^claude-code: the ctxtra MCP proxy is gone from ~/.claude.json; if that wasn''t on purpose, run ctxtra setup --agent claude-code'
exec ctxtra setup --agent claude-code

# Removal still cleans up the entry after the config stops declaring servers.
cp empty.yaml .config/ctxtra/config.yaml
exec ctxtra setup --remove --agent claude-code
! grep '"ctxtra-proxy":' .claude.json
cp config.yaml .config/ctxtra/config.yaml
exec ctxtra setup --agent claude-code

# The entry under its old name, ctxtra: notices say to run setup, which
# renames it in its place.
cp legacy.json .claude.json
exec ctxtra binding list
stderr '^claude-code: the ctxtra MCP proxy has its old name ctxtra; run ctxtra setup --agent claude-code$'
exec ctxtra setup --agent claude-code
cmpenv .claude.json want.json
exec ctxtra binding list
! stderr .

# A server of the user's named ctxtra stays.
cp users.json .claude.json
exec ctxtra setup --agent claude-code
grep '"command": "ctxtra-docs"' .claude.json
grep '"ctxtra-proxy":' .claude.json
exec ctxtra setup --remove --agent claude-code
cmp .claude.json users.json

# $CLAUDE_CONFIG_DIR moves the file.
env CLAUDE_CONFIG_DIR=$HOME/claude-dir
exec ctxtra setup --agent claude-code
exists claude-dir/.claude.json
grep '"args": \[' claude-dir/.claude.json

-- config.yaml --
schema: ctxtra/config/v1
mcp-servers:
  pg: {command: [pg-mcp]}
-- empty.yaml --
schema: ctxtra/config/v1
-- .claude.json --
{
  "numStartups": 3,
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    }
  }
}
-- legacy.json --
{
  "numStartups": 3,
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "ctxtra": {
      "type": "stdio",
      "command": "/old/ctxtra",
      "args": [
        "mcp",
        "proxy",
        "claude-code",
        "--setup-version=1"
      ]
    }
  }
}
-- users.json --
{
  "mcpServers": {
    "ctxtra": {
      "command": "ctxtra-docs"
    }
  }
}
-- original.json --
{
  "numStartups": 3,
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    }
  }
}
-- want.json --
{
  "numStartups": 3,
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "ctxtra-proxy": {
      "type": "stdio",
      "command": "$BIN",
      "args": [
        "mcp",
        "proxy",
        "claude-code",
        "--setup-version=1"
      ]
    }
  }
}
