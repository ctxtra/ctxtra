# The hook never breaks a session: a missing file, a broken config or a
# missing binary still give the agent a valid answer and exit 0.

exec ctxtra setup --agent claude-code

# A missing bound file is skipped, and the session message names it with
# its line.
runhook claude-code SessionStart notes
stdout 'CTXMARK-PERSONAL'
stdout '"systemMessage":"✓ ctxtra added 2 instructions; 1 error \(run ctxtra doctor\)\\nInstructions:\\n  local\\n  - ~/ctx/me.md\\n  - ~/ctx/notes.md\\n\\n⚠ ~/.config/ctxtra/config.yaml: line 4: binding me: ~/ctx/gone.md is not a file; the entry is left out"'
! stderr .

# Outside git, repos don't match; global and dirs do.
stdout 'CTXMARK-NOTES'
! stdout 'CTXMARK-REPO'

# A config with a wrong schema adds nothing. Setup refuses to run over it.
cp .config/ctxtra/config.yaml good.yaml
cp broken.yaml .config/ctxtra/config.yaml
runhook claude-code SessionStart notes
! stdout 'CTXMARK'
stdout 'systemMessage'
! exec ctxtra doctor
stdout 'schema ctxtra/config/v9.*a config has schema: ctxtra/config/v1'
! exec ctxtra setup --agent claude-code --dry-run
stderr '^ctxtra setup: ~/.config/ctxtra/config.yaml: line 1: schema ctxtra/config/v9'
! stdout .
cp good.yaml .config/ctxtra/config.yaml

# When the binary is gone, the hook command tells the user at session
# start, and answers {} for a subagent. Set up from a copy of the binary,
# then delete the copy.
mkdir bin
exec cp $BIN bin/ctxtra
exec bin/ctxtra setup --agent claude-code
rm bin/ctxtra
runhook claude-code SessionStart notes
stdout '^\{"systemMessage":"ctxtra: the ctxtra binary that this hook runs is missing; reinstall ctxtra, or run ctxtra setup --agent claude-code with the new binary"\}$'
runhook claude-code SubagentStart notes
stdout '^\{\}$'
! exec ctxtra doctor
stdout 'claude-code: .*MISSING'
! stderr .
! exec ctxtra context files
stderr '^claude-code: the hooks run ~/bin/ctxtra, which doesn''t exist; run ctxtra setup --agent claude-code$'

-- .config/ctxtra/config.yaml --
schema: ctxtra/config/v1
bindings:
  - name: me
    instructions: [~/ctx/me.md, ~/ctx/gone.md]
  - name: notes
    location:
      dirs: [~/notes/**]
    instructions: [~/ctx/notes.md]
  - name: repo
    location:
      repos:
        - github.com/**
    instructions: [~/ctx/repo.md]
-- broken.yaml --
schema: ctxtra/config/v9
-- ctx/me.md --
CTXMARK-PERSONAL
-- ctx/notes.md --
CTXMARK-NOTES
-- ctx/repo.md --
CTXMARK-REPO
-- notes/todo.md --
plain folder
