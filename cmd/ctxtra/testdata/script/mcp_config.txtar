# MCP servers work without opt-in: servers are checked one by one,
# and bindings name them.

mkdir .config/ctxtra
cp config.yaml .config/ctxtra/config.yaml
mkdir dev/api

! exec ctxtra doctor dev/api
stdout 'ERROR: ~/.config/ctxtra/config.yaml: line 6: MCP server linear-work: server name "linear-work": names are 1 to 20 characters of a-z, 0-9 and _, start with a letter, and have no __ and no _ at the end; for example linear_work; MCP server linear-work is left out'
stdout 'ERROR: ~/.config/ctxtra/config.yaml: line 7: MCP server plain: url "http://example.com/mcp": remote servers need https'
stdout 'ERROR: ~/.config/ctxtra/config.yaml: line 12: binding typo: the config has no MCP server linear_wrok; the entry is left out'
stdout 'NOTE: mcp-servers.internal: headers.Authorization looks like a secret, which the config shouldn''t hold; use secret-headers: \[Authorization\]'

! exec ctxtra context explain dev/api
stdout '^\+ work: '
stdout '^    mcp      linear_work$'
stdout '^    mcp      pg$'
stdout '^    skip     mcp linear_work \(already added by an earlier binding\)$'
stdout 'total: 0 files, 0 skills, .*2 MCP servers$'
stdout ', 2 MCP servers$'
! exec ctxtra context explain --json dev/api
stdout '"mcp_servers": \['
stdout '"path": "pg",\s+"status": "added"'

# A binding with only servers is valid.
! exec ctxtra context explain .
stdout '^- work'
! stdout 'MCP servers'

# source validate reads the package manifest, not the user's config.
! exec ctxtra source validate team
stdout 'server name "Bad"'
! stdout 'linear'

-- config.yaml --
schema: ctxtra/config/v1
mcp-servers:
  linear_work: {url: https://mcp.linear.app/mcp}
  pg: {command: [pg-mcp]}
  internal: {url: https://mcp.internal.example/mcp, headers: {Authorization: Bearer abc}}
  linear-work: {url: https://mcp.linear.app/mcp}
  plain: {url: http://example.com/mcp}
bindings:
  - name: work
    location: {dirs: ['~/dev/**']}
    mcp-servers: [linear_work, pg]
  - {name: typo, location: {dirs: ['~/dev/**']}, mcp-servers: [linear_wrok, linear_work]}
-- team/ctxtra-source.yaml --
schema: ctxtra/source/v1
mcp-servers:
  linear: {url: https://example.com/mcp}
  Bad: {command: [bad]}
