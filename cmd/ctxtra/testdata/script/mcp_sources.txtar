# Source catalogs are local, scoped, and cannot start unapproved servers.
mkdir dev/app
exec git -C pkg init -b main
exec git -C pkg add .
exec git -C pkg commit -m initial
exec ctxtra source check pkg
stdout '0 errors, 0 warnings'
exec ctxtra source add local-git pkg --name work --include bindings.yaml
stdout 'MCP definition work/build:'
stdout 'MCP servers: build'
exec ctxtra mcp list --json
stdout '"id": "work/build"'
stdout '"name": "build"'
stdout '"source": "work"'
stdout '"approval": "approval needed"'
! exists .local/state/ctxtra/mcp/key.json
! exec ctxtra mcp show work/build
stderr 'approval needed; run ctxtra mcp approve work/build'
! exec ctxtra mcp show work/web
stderr 'approval needed; run ctxtra mcp approve work/web'
! exists .local/state/ctxtra/mcp/key.json

# Approval is never unattended, even if stdin contains yes.
stdin yes.txt
! exec ctxtra mcp approve work/build
stderr 'needs your terminal'
! exists .local/state/ctxtra/mcp/approval/work%2Fbuild.json
exec ctxtra setup --agent claude
runhook claude SessionStart dev/app
stdout 'work/build needs approval: run ctxtra mcp approve work/build'

# A decline is remembered, but does not grant connection permission.
stdin no.txt
! exec ctxtra-tty mcp approve work/build
stderr 'approval of work/build declined'
runhook claude SessionStart dev/app
! stdout 'needs approval'
exec ctxtra mcp list
stdout 'work/build  local, none needed, approval declined'
! exec ctxtra mcp show work/build
stderr 'approval needed'

# Approval performs no MCP startup and creates no credential key.
stdin yes.txt
exec ctxtra-tty mcp approve work/build
stdout 'approved work/build on this machine; no connection or command started'
! exists .local/state/ctxtra/mcp/key.json
exec ctxtra mcp show work/build
stdout '^  build__echo$'
stdout '^  build__package$'
mcp dev/app
stdout '^tool build__echo'
stdout '^tool build__package'
! stdout 'work__'
exec ctxtra mcp status dev/app
stdout 'work/build'
stdout 'tool prefix: build; approved'
! stdout 'local-git:'

# A package definition is read-only to mcp remove.
! exec ctxtra mcp remove work/build
stderr 'package definition; change its bindings or remove the source'

# Separate approval consent precedes a secret prompt in login.
stdin login.txt
exec ctxtra-tty mcp login work/secure
stdout 'stored the secret values of work/secure'
! stdout CTXMARK
! stderr CTXMARK
exists .local/state/ctxtra/mcp/credentials/work%2Fsecure.v1.age
exec ctxtra mcp revoke work/secure
stdout 'Credentials and provider grants remain'
exists .local/state/ctxtra/mcp/credentials/work%2Fsecure.v1.age
exec ctxtra mcp logout work/secure
stdout 'deleted the sign-in and secret values of work/secure'

# An accepted operational change needs approval again, not just source acceptance.
cp updated.yaml pkg/mcp-servers.yaml
exec git -C pkg add .
exec git -C pkg commit -m 'change environment'
stdin yes.txt
exec ctxtra-tty source update work
stdout 'work/build changed its operational definition'
exec ctxtra mcp list
stdout 'work/build  local, none needed, approval needed'
! exec ctxtra mcp show work/build
stderr 'approval needed'
stdin yes.txt
exec ctxtra-tty mcp approve work/build

# Widened targeting is reviewed but does not invalidate unchanged approval.
cp global.yaml pkg/bindings.yaml
exec git -C pkg add .
exec git -C pkg commit -m 'widen targeting'
stdin yes.txt
exec ctxtra-tty source update work
stdout 'now applies to every session'
exec ctxtra mcp list
stdout 'work/build  local, none needed, approved'

# Revoke and logout are different operations.
exec ctxtra mcp revoke work/build
! exec ctxtra mcp show work/build
stderr 'approval needed'

# Config bindings win conflicts. A failed winner never selects the package.
exec ctxtra mcp add build --no-login -- missing-mcp-command
exec ctxtra binding add mine --global --mcp build
! exec ctxtra context explain dev/app
stdout 'work/build.*shadowed by build'
runhook claude SessionStart dev/app
stdout 'MCP server work/build is shadowed by build'
mcp dev/app
! stdout '^tool build__'
exec ctxtra mcp status dev/app
stdout 'work/build shadowed by build'

# Removing a source leaves shared credentials for explicit cleanup.
exec ctxtra source remove work
stdout 'MCP credentials for work/secure remain'
stdout 'ctxtra mcp remove work/secure'
exists .local/state/ctxtra/mcp/credentials/work%2Fsecure.v1.age
exec ctxtra doctor
stdout 'MCP credentials for work/secure are not declared in this config'
exec ctxtra mcp remove work/secure
stdout 'deleted leftover credentials of work/secure'
! exists .local/state/ctxtra/mcp/credentials/work%2Fsecure.v1.age

-- yes.txt --
y
-- no.txt --
n
-- login.txt --
y
CTXMARK-secret
-- pkg/mcp-servers.yaml --
schema: ctxtra/v1
mcp-servers:
  build:
    command: [mcptest, -tools, package]
  secure:
    command: [mcptest]
    secret-env: [TOKEN]
  web:
    url: https://example.invalid/mcp
-- updated.yaml --
schema: ctxtra/v1
mcp-servers:
  build:
    command: [mcptest, -tools, package]
    env: {MODE: read}
  secure:
    command: [mcptest]
    secret-env: [TOKEN]
  web:
    url: https://example.invalid/mcp
-- global.yaml --
schema: ctxtra/v1
bindings:
  - name: work
    match: {global: true}
    mcp-servers: [build]
-- pkg/bindings.yaml --
schema: ctxtra/v1
bindings:
  - name: work
    match: {dirs: ['~/dev/**']}
    mcp-servers: [build]
