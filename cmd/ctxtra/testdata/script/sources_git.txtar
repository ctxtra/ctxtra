# A team repository added by URL is pinned: sessions read the accepted
# commit from ctxtra's store, and a new commit applies only after sync shows
# it and the user accepts it, in a terminal.

chmod 755 srv/team-ctx/skills/deploy/run.sh
gitrepo srv/team-ctx
exec ctxtra setup --agent claude-code

# Adding a source records its accepted commit in the lock. Binding it is separate.
exec ctxtra source add --repo $GITSRV/team-ctx
stdout '^fetched team-ctx: main at [0-9a-f]{7} \(https://127.0.0.1:\d+/team-ctx\)$'
stdout '^added source team-ctx: new commits apply after you accept them in ctxtra source update team-ctx$'
stdout '^executable files: skills/deploy/run.sh$'
grep '^    commit: [0-9a-f]{40}$' .config/ctxtra/ctxtra.lock
exec ctxtra binding add billing --instruction team-ctx:services-overview.md --skill team-ctx:skills/deploy
stdout '^added binding billing to ~/.config/ctxtra/config.yaml: every session$'
stdout '^  instructions: team-ctx:services-overview.md$'
stdout '^  skills: team-ctx:skills/deploy$'
runhook claude-code SessionStart notes
stdout 'CTXMARK-OVERVIEW'
stdout 'Contents of .*/.local/share/ctxtra/store/[0-9a-f]{16}/[0-9a-f]{40}/services-overview.md'
stdout '<location>.*/.local/share/ctxtra/store/[0-9a-f]{16}/[0-9a-f]{40}/skills/deploy/SKILL.md</location>'

# A new commit changes nothing until sync.
cp new-overview.md srv/team-ctx/services-overview.md
gitcommit srv/team-ctx
runhook claude-code SessionStart notes
stdout 'CTXMARK-OVERVIEW'
! stdout 'CTXMARK-NEW'

# Accepting needs a terminal: without one, update fetches and records
# nothing. --dry-run fetches and reviews, and decides nothing.
! exec ctxtra source update
stderr 'accepting a new commit needs a terminal'
! stdout .
! exec ctxtra-tty --no-input source update
stderr 'accepting a new commit needs a terminal'
exec ctxtra source update --dry-run
stdout '^\+CTXMARK-NEW$'
stdout '^team-ctx: not accepted \(--dry-run\); to accept it, run in a terminal: ctxtra source update team-ctx$'
exec ctxtra source update --dry-run --json
stdout '"pending": true'
exec ctxtra source show team-ctx
! stdout 'dismissed'
runhook claude-code SessionStart notes
! stdout 'CTXMARK-NEW'

# Input that ends without an answer decides nothing.
stdin empty.txt
! exec ctxtra-tty source update
stderr 'no answer; nothing accepted or dismissed'
exec ctxtra source show team-ctx
! stdout 'dismissed'

# update shows the diff; N keeps the old commit, y accepts the new one.
stdin no.txt
exec ctxtra-tty source update
stdout '^team-ctx: [0-9a-f]{7} -> [0-9a-f]{7} \(main, https://'
stdout '^-CTXMARK-OVERVIEW$'
stdout '^\+CTXMARK-NEW$'
stdout 'not accepted; you keep [0-9a-f]{7}$'
! stdout 'warning:'
exec ctxtra source list
stdout '^team-ctx: repo https://.*, branch main, at [0-9a-f]{7} \(new commits apply after you accept them in ctxtra source update\), last fetched .*, [0-9a-f]{7} not accepted \(dismissed\); no new commits but the dismissed one \(checked .*\)$'
stdin yes.txt
exec ctxtra-tty source update team-ctx
stdout 'accepted team-ctx [0-9a-f]{7} \(ctxtra.lock updated\)$'
runhook claude-code SessionStart notes
stdout 'CTXMARK-NEW'
exec ctxtra-tty source update
stdout '^team-ctx: up to date \(main at [0-9a-f]{7}\)$'

# The edits keep the comments in the config.
grep '^# my comment$' .config/ctxtra/config.yaml
grep '^  - name: me  # mine$' .config/ctxtra/config.yaml

# A new laptop: the config is there, the store isn't. Restore fetches the
# accepted commit, not the branch.
cp .config/ctxtra/ctxtra.lock saved.lock
rm .local/share/ctxtra .cache/ctxtra
runhook claude-code SessionStart notes
! stdout 'CTXMARK'
! exec ctxtra doctor notes
stdout 'source team-ctx: repo https://.*, branch main, INACTIVE: the accepted commit [0-9a-f]{7} is not downloaded on this machine; run `ctxtra source download`'
exec ctxtra source download
stdout '^team-ctx: downloaded [0-9a-f]{7} \(the commit in ctxtra.lock\)$'
runhook claude-code SessionStart notes
stdout 'CTXMARK-NEW'
exec ctxtra source download
stdout '^team-ctx: [0-9a-f]{7} is downloaded$'
cmp .config/ctxtra/ctxtra.lock saved.lock

# A force-push: the new commit doesn't continue the accepted one.
exec git -C srv/team-ctx reset -q --hard HEAD~1
cp other.md srv/team-ctx/other.md
gitcommit srv/team-ctx
stdin no.txt
exec ctxtra-tty source update
stdout 'warning: [0-9a-f]{7} doesn''t continue [0-9a-f]{7}: the branch was force-pushed'

-- .config/ctxtra/config.yaml --
schema: ctxtra/config/v1
# my comment
bindings:
  - name: me  # mine
    instructions: [~/notes/me.md]
-- .config/ctxtra/bindings.yaml --
schema: ctxtra/config/v1
bindings:
  - name: me  # mine
    instructions: [~/notes/me.md]
-- notes/me.md --
mine
-- empty.txt --
-- no.txt --
n
-- yes.txt --
y
-- new-overview.md --
CTXMARK-NEW
-- other.md --
other
-- srv/team-ctx/services-overview.md --
CTXMARK-OVERVIEW
-- srv/team-ctx/skills/deploy/SKILL.md --
---
description: Deploy.
---
-- srv/team-ctx/skills/deploy/run.sh --
#!/bin/sh
