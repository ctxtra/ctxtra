# Sessions tell about new commits of pinned sources by default,
# from what the last check found. The check reads only the branch's commit:
# the session keeps the accepted one until source update. The config turns
# the release check off, so nothing here asks GitHub.

gitrepo srv/team-ctx
gitrepo srv/plain
exec ctxtra setup --agent claude-code

# source add says whether sessions check the source.
exec ctxtra source add git $GITSRV/plain --check-updates=false
stdout '^update checks are off for plain \(check-updates: false\)$'
! stdout 'checks use your git credentials'
exec ctxtra source add git $GITSRV/team-ctx --include bindings/billing.yaml
stdout '^sessions check team-ctx for new commits at most once an hour and tell you when there are some \(check-updates: true\)$'
stdout 'checks use your git credentials; credential helpers or hardware keys may ask for approval or a touch'
stdout 'To turn checks off, set check-updates: false on this source'
grep '^    check-updates: false$' .config/ctxtra/config.yaml
exec ctxtra source show team-ctx --json
stdout '"check_updates": true'
exec ctxtra source show plain --json
stdout '"check_updates": false'

# Up to date: no notice. A source with checks disabled isn't checked.
exec ctxtra check-updates
stdout '^team-ctx: no new commits \(checked \d{4}-\d\d-\d\d \d\d:\d\d\)$'
! stdout 'plain|ctxtra'
runhook claude-code SessionStart notes
stdout 'CTXMARK-OVERVIEW'
! stdout 'ℹ'

# A new commit is no notice until a check finds it.
cp new-overview.md srv/team-ctx/services-overview.md
gitcommit srv/team-ctx
runhook claude-code SessionStart notes
! stdout 'ℹ'
exec ctxtra check-updates
stdout '^team-ctx: new commits \(checked .*\); run `ctxtra source update team-ctx` to review them$'
runhook claude-code SessionStart notes
stdout '\\n\\nℹ team-ctx has new commits on main\\n  run `ctxtra source update team-ctx` to review them.'
stdout 'CTXMARK-OVERVIEW'
! stdout 'CTXMARK-NEW'
exec ctxtra doctor notes
stdout '^ctxtra .*: release check off \(check-updates: false\)$'
stdout '^  source team-ctx: .*; new commits \(checked .*\); run `ctxtra source update team-ctx` to review them$'
stdout '^  NOTICE: team-ctx has new commits on main; run `ctxtra source update team-ctx` to review them.$'
stdout '^  source plain: .*; update checks off \(remove check-updates: false to turn them on\)$'

# Accepting the commit ends the notice.
stdin yes.txt
exec ctxtra-tty source update team-ctx
runhook claude-code SessionStart notes
stdout 'CTXMARK-NEW'
! stdout 'ℹ'

# Results that can't be saved are shown from the check, and the command fails.
rm .local/state/ctxtra/state.lock
mkdir .local/state/ctxtra/state.lock
! exec ctxtra check-updates
stdout '^team-ctx: no new commits \(checked '
stderr 'can''t save the results in ~/.local/state/ctxtra/state.json, so sessions won''t show them'
rm .local/state/ctxtra/state.lock

# A check that fails says why, and is no notice.
mv srv/team-ctx srv/moved
! exec ctxtra check-updates
stdout '^team-ctx: can''t check: git ls-remote: '
exec ctxtra doctor notes
stdout '^  source team-ctx: .*; the last check for new commits failed: git ls-remote: '
runhook claude-code SessionStart notes
! stdout 'ℹ'

# With every check off, there is nothing to check.
cp off.yaml .config/ctxtra/config.yaml
exec ctxtra check-updates
stdout '^nothing to check: the config has check-updates: false, and no source has update checks enabled$'

-- .config/ctxtra/config.yaml --
schema: ctxtra/v1
check-updates: false
include:
  - bindings.yaml
-- .config/ctxtra/bindings.yaml --
schema: ctxtra/v1
bindings:
  - name: me
    match:
      global: true
    instructions: [~/notes/me.md]
-- off.yaml --
schema: ctxtra/v1
check-updates: false
-- notes/me.md --
mine
-- yes.txt --
y
-- new-overview.md --
CTXMARK-NEW
-- srv/team-ctx/services-overview.md --
CTXMARK-OVERVIEW
-- srv/team-ctx/bindings/billing.yaml --
schema: ctxtra/v1
bindings:
  - name: billing
    match:
      global: true
    instructions: [../services-overview.md]
-- srv/plain/README.md --
plain
