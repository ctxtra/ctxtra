# A file in a git repository with a remote is read only when the repository
# is a trusted source. Files outside git and in repositories without a remote
# are always read.

gitrepo dev/team https://github.com/acme/team
gitrepo dev/dotfiles git@github.com:me/dotfiles.git
gitrepo own

exec ctxtra setup --agent claude-code
runhook claude-code SessionStart notes
stdout 'CTXMARK-NOTES'
stdout 'CTXMARK-OWN'
! stdout 'CTXMARK-TEAM'
! stdout 'CTXMARK-DOT'
stdout '"systemMessage":"✓ ctxtra added 2 instructions; 3 errors \(run ctxtra doctor\)\\nInstructions:\\n  local\\n  - ~/ctx/me.md\\n  - ~/own/own.md\\n\\n⚠ ~/.config/ctxtra/config.yaml: binding me: ~/dev/team/team.md is in ~/dev/team, which has the remote github.com/acme/team[^"]*…\\n'

! exec ctxtra context files notes
stderr 'error: .*~/dev/team/team.md is in ~/dev/team, which has the remote github.com/acme/team and is not a trusted source; skipped. To read it live, add the folder as a dir source and trust it: ctxtra source add --dir ~/dev/team, then ctxtra source trust NAME; to read reviewed commits: ctxtra source add --repo ~/dev/team'
stderr 'error: .*~/dev/dotfiles/work.md is in ~/dev/dotfiles'

! exec ctxtra context explain notes
stdout 'error +.*~/dev/team/team.md is in ~/dev/team'

# Trusting the dotfiles makes their explicitly bound content live. The team repository stays untrusted.
cp trusted.yaml .config/ctxtra/config.yaml
exec ctxtra source trust dotfiles
! exec ctxtra context files notes
stdout '/ctx/me.md'
stdout '/dev/dotfiles/work.md'
stdout '/dev/dotfiles/skills/deploy/SKILL.md'
! stdout 'team.md'
stderr 'dev/team/team.md is in ~/dev/team'
! stderr 'dotfiles'

! exec ctxtra doctor notes
stdout 'source dotfiles: dir ~/dev/dotfiles'

# A symlink in a trusted source can lead outside it, but only to a file that
# is trusted on its own.
symlink dev/dotfiles/own-link.md -> ../../ctx/outside.md
symlink dev/dotfiles/team-link.md -> ../team/team.md
cp links.yaml .config/ctxtra/config.yaml
! exec ctxtra context files notes
stdout '/ctx/outside.md'
stderr 'dev/dotfiles/team-link.md leads through a symlink to ~/dev/team/team.md, which is in ~/dev/team'

# A dir source whose folder is a symlink in another repository with a remote
# is not read, and can't be trusted: whoever pushes there can change the link.
symlink dev/team/notes -> ../../ctx
cp routed.yaml .config/ctxtra/config.yaml
! exec ctxtra source trust notes
stderr '~/dev/team/notes leads through a symlink at ~/dev/team/notes, in ~/dev/team, which has the remotes github.com/acme/team'
! exec ctxtra context files notes
! stdout 'ctx/me.md'
stderr '~/dev/team/notes leads through a symlink'

-- routed.yaml --
schema: ctxtra/config/v1
sources:
  notes:
    dir: ~/dev/team/notes
bindings:
  - name: me
    instructions: [notes:me.md]
-- .config/ctxtra/config.yaml --
schema: ctxtra/config/v1
bindings:
  - name: me
    instructions: [~/ctx/me.md, ~/own/own.md, ~/dev/team/team.md]
  - name: work
    instructions: [~/dev/dotfiles/work.md]
    skills: [~/dev/dotfiles/skills/deploy]
-- trusted.yaml --
schema: ctxtra/config/v1
sources:
  dotfiles:
    dir: ~/dev/dotfiles
bindings:
  - name: me
    instructions: [~/ctx/me.md, ~/own/own.md, ~/dev/team/team.md]
  - name: work
    instructions: [dotfiles:work.md]
    skills: [dotfiles:skills/deploy]
-- links.yaml --
schema: ctxtra/config/v1
sources:
  dotfiles:
    dir: ~/dev/dotfiles
bindings:
  - name: work
    instructions: [dotfiles:own-link.md, dotfiles:team-link.md]
-- ctx/outside.md --
CTXMARK-OUTSIDE
-- ctx/me.md --
CTXMARK-NOTES
-- own/own.md --
CTXMARK-OWN
-- dev/team/team.md --
CTXMARK-TEAM
-- dev/dotfiles/work.md --
CTXMARK-DOT
-- dev/dotfiles/skills/deploy/SKILL.md --
---
description: Deploy.
---
-- notes/.keep --
