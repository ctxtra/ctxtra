cp .config/ctxtra/config.yaml original.yaml
# binding add adds a binding to the config and keeps the rest of it as
# written. It writes only a binding that sessions would get as asked: its
# files exist and are trusted. binding remove takes it out again.

gitrepo dev/team git@github.com:acme/team.git

# Relative paths are relative to the current folder, and written from ~.
cd notes
exec ctxtra binding add work --dir '~/dev/work/**' --repo 'github.com/acme/**' --instruction work.md --skill ../skills/deploy
stdout '^added binding work to ~/.config/ctxtra/config.yaml: sessions in folders ~/dev/work/\*\* or in repositories github.com/acme/\*\*$'
stdout '^  instructions: ~/notes/work.md$'
stdout '^  skills: ~/skills/deploy$'
stdout '^new sessions get it'
cd $HOME
cmp .config/ctxtra/config.yaml want.yaml
exec ctxtra context files dev/work/svc
stdout '/notes/work.md$'
stdout '/skills/deploy/SKILL.md$'

# Flags may come first.
exec ctxtra binding add --instruction notes/me.md me2
stdout '^added binding me2 to ~/.config/ctxtra/config.yaml: every session$'
exec ctxtra context files elsewhere
stdout '/notes/me.md$'
cp want.yaml .config/ctxtra/config.yaml

# Nothing is written for a binding that wouldn't work.
! exec ctxtra binding add me --instruction notes/me.md
stderr 'a binding named me already exists'
! exec ctxtra binding add x --instruction notes/nope.md
stderr 'nothing changed'
stderr 'line 18: binding x: ~/notes/nope.md is not a file; the entry is left out$'
! exec ctxtra binding add x --skill notes
stderr '~/notes is not a skill folder with a SKILL.md'
! exec ctxtra binding add x --dir '/a/[' --instruction notes/me.md
stderr '/a/\[ is not a valid pattern'
stderr 'line \d+: binding x: /a/\['
! exec ctxtra binding add x --instruction nope:a.md
stderr 'the config has no source nope'
! exec ctxtra binding add x --instruction dev/team/team.md
stderr 'not a trusted source; skipped. To read it live, add the folder as a dir source and trust it: ctxtra source add --dir ~/dev/team'
cmp .config/ctxtra/config.yaml want.yaml

# --dry-run checks and changes nothing, also where nothing can be written,
# as in an agent's sandbox.
chmod 0555 .config/ctxtra
chmod 0555 .local/state/ctxtra
exec ctxtra binding add x --instruction notes/me.md --dry-run
stdout '^would add binding x to ~/.config/ctxtra/config.yaml: every session$'
stdout '^nothing changed \(--dry-run\)$'
! exec ctxtra binding add x --instruction notes/nope.md --dry-run
stderr 'line 18: binding x: ~/notes/nope.md is not a file; the entry is left out$'
! exec ctxtra binding add x --instruction notes/me.md
stderr 'permission denied'
chmod 0755 .config/ctxtra
chmod 0755 .local/state/ctxtra
cmp .config/ctxtra/config.yaml want.yaml

# Remote live folders require explicit trust.
exec ctxtra source add --dir dev/team
exec ctxtra source trust team
exec ctxtra binding add team --instruction team:team.md --instruction dev/team/team.md
stdout '^  instructions: team:team.md, ~/dev/team/team.md$'
grep '^      - team:team.md$' .config/ctxtra/config.yaml
grep '^      - ~/dev/team/team.md$' .config/ctxtra/config.yaml
exec ctxtra binding list
stdout '^me: every session$'
stdout '^team: every session$'
stdout '^  instruction  ~/dev/team/team.md$'
exec ctxtra binding list --json
stdout '"name": "team"'
exec ctxtra binding remove team --dry-run
stdout '^would remove binding team'
grep 'name: team' .config/ctxtra/config.yaml
exec ctxtra binding remove team
stdout '^removed binding team from ~/.config/ctxtra/config.yaml$'
! grep 'name: team' .config/ctxtra/config.yaml
grep 'name: work' .config/ctxtra/config.yaml
! exec ctxtra binding remove team
stderr 'no binding named team'

cp pinned.yaml .config/ctxtra/config.yaml
cp pinned.lock .config/ctxtra/ctxtra.lock
cp pinned.yaml pinned-want.yaml
! exec ctxtra binding add y --instruction pin:a.md
stderr 'source pin: the accepted commit 1111111 is not downloaded on this machine; run `ctxtra source download`'
cmp .config/ctxtra/config.yaml pinned-want.yaml

cp budget.yaml .config/ctxtra/config.yaml
! exec ctxtra binding add y --instruction notes/work.md
stderr '~/notes/work.md would be dropped \(over max-ctx-chars \(5\)\)'
cp original.yaml .config/ctxtra/config.yaml
cp broken.yaml .config/ctxtra/config.yaml
exec ctxtra binding remove broken
stdout '^removed binding broken'
! grep broken .config/ctxtra/config.yaml
! exec ctxtra skill install ctxtra --dry-run
stderr 'a binding named ctxtra already exists'
! exec ctxtra skill install ctxtra
stderr 'a binding named ctxtra already exists'
! exists .local/share/ctxtra/skills/ctxtra
cp original.yaml .config/ctxtra/config.yaml

# Usage errors.
! exec ctxtra binding add x
stderr 'add at least one --instruction, --skill or --mcp-server'
! exec ctxtra binding add 'a b' --instruction notes/me.md
stderr 'names are 1 to 64 letters, digits, .'
! exec ctxtra binding add --instruction notes/me.md
stderr 'expected NAME'

-- .config/ctxtra/config.yaml --
schema: ctxtra/config/v1

bindings:           # mine
  - name: me
    instructions: [../../notes/me.md]

max-ctx-chars: 40000  # enough
-- want.yaml --
schema: ctxtra/config/v1

bindings:           # mine
  - name: me
    instructions: [../../notes/me.md]
  - name: work
    location:
      dirs:
        - '~/dev/work/**'
      repos:
        - 'github.com/acme/**'
    instructions:
      - ~/notes/work.md
    skills:
      - ~/skills/deploy

max-ctx-chars: 40000  # enough
-- pinned.yaml --
schema: ctxtra/config/v1
sources:
  pin:
    repo: ~/dev/team
    branch: main
bindings:
  - name: x
    instructions:
      - pin:a.md
-- broken.yaml --
schema: ctxtra/config/v1
bindings:
  - name: broken
    instructions: []
  - name: ctxtra
    instructions: [notes/me.md]
-- budget.yaml --
schema: ctxtra/config/v1
max-ctx-chars: 5
-- notes/me.md --
CTXMARK-ME
-- notes/work.md --
CTXMARK-WORK
-- skills/deploy/SKILL.md --
---
description: Deploy the service.
---
-- dev/team/team.md --
CTXMARK-TEAM
-- dev/work/svc/.keep --
-- elsewhere/.keep --
-- pinned.lock --
schema: ctxtra/lock/v1
sources:
  pin:
    repo: ~/dev/team
    branch: main
    commit: '1111111111111111111111111111111111111111'
