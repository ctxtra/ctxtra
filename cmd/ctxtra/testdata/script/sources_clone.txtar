# A local repository source follows its named branch and reads accepted
# commits. Dirty edits never reach the session.
gitrepo srv/team-ctx
exec git clone -q $GITSRV/team-ctx dev/team-ctx
cp local.md dev/team-ctx/jira-ticket.md
cp local.md dev/team-ctx/tool.sh
chmod 755 dev/team-ctx/tool.sh
gitcommit dev/team-ctx
exec ctxtra setup --agent claude-code
exec ctxtra source add --repo $HOME/dev/team-ctx
stdout '^fetched team-ctx: main at [0-9a-f]{7} \(~/dev/team-ctx\)$'
stdout '^added source team-ctx: new commits apply after you accept them in ctxtra source update team-ctx$'
stdout '^executable files: tool.sh$'
! stdout 'checks use your git credentials'
exec ctxtra source show team-ctx --json
stdout '"kind": "repo"'
stdout '"location": "~/dev/team-ctx"'
stdout '"branch": "main"'
stdout '"check_updates": true'
grep '^    repo: ~/dev/team-ctx$' .config/ctxtra/config.yaml
exec ctxtra binding add me --instruction team-ctx:jira-ticket.md
exec ctxtra binding add team --dir ~/nowhere --instruction team-ctx:services-overview.md
cp uncommitted.md dev/team-ctx/jira-ticket.md
runhook claude-code SessionStart notes
stdout 'Contents of .*/.local/share/ctxtra/store/.*/jira-ticket.md'
stdout 'LOCAL-COMMIT'
! stdout 'UNCOMMITTED'
! stdout 'ctxtra notices'
exec ctxtra doctor notes
stdout 'source team-ctx: repo ~/dev/team-ctx, branch main'

# Repeated adds preserve both files, even with another requested name.
cp .config/ctxtra/config.yaml before.yaml
cp .config/ctxtra/ctxtra.lock before.lock
exec ctxtra source add --repo $HOME/dev/team-ctx --name another
stdout 'branch main, is the source team-ctx already'
cmp .config/ctxtra/config.yaml before.yaml
cmp .config/ctxtra/ctxtra.lock before.lock
exec ctxtra source add --repo $HOME/dev/team-ctx --check-updates=false
stdout 'is the source team-ctx already'
exec ctxtra source show team-ctx --json
stdout '"check_updates": true'
exec git clone -q dev/team-ctx dev/quiet
exec ctxtra source add --repo $HOME/dev/quiet --name quiet-dev --check-updates=false
stdout '^update checks are off for quiet-dev \(check-updates: false\)$'
exec ctxtra source show quiet-dev --json
stdout '"check_updates": false'
exec ctxtra source remove quiet-dev

cp wip.md dev/team-ctx/services-overview.md
gitcommit dev/team-ctx
stdin yes.txt
exec ctxtra-tty source update team-ctx
stdout '^team-ctx: [0-9a-f]{7} -> [0-9a-f]{7} \(main, ~/dev/team-ctx\)$'
stdout 'accepted team-ctx'
exec ctxtra doctor notes
stdout 'source team-ctx: repo ~/dev/team-ctx, branch main, at [0-9a-f]{7}'

# Removing a source keeps bindings and reports each dangling reference.
exec ctxtra source remove team-ctx --dry-run
stdout '^would remove source team-ctx from ~/.config/ctxtra/config.yaml$'
grep 'team-ctx:' .config/ctxtra/config.yaml
exec ctxtra source remove team-ctx
stdout '^removed source team-ctx from ~/.config/ctxtra/config.yaml$'
stderr '^warning: binding me still uses team-ctx:jira-ticket.md; that entry is an error until you remove it$'
stderr '^warning: binding team still uses team-ctx:services-overview.md; that entry is an error until you remove it$'
! grep '^  team-ctx:' .config/ctxtra/config.yaml
! grep '^  team-ctx:' .config/ctxtra/ctxtra.lock
! exec ctxtra context files notes
stderr 'the config has no source team-ctx'
! stdout 'jira-ticket.md'

-- notes/.keep --
-- yes.txt --
y
-- local.md --
LOCAL-COMMIT
-- uncommitted.md --
UNCOMMITTED
-- wip.md --
WIP
-- srv/team-ctx/jira-ticket.md --
REMOTE
-- srv/team-ctx/services-overview.md --
overview
